# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` — it is excluded in .gitignore.

# --- Discord bot ---
# Create an application + bot at https://discord.com/developers/applications
DISCORD_TOKEN="your_token_here"
DISCORD_APPLICATION_ID="your_application_id_here"
# Comma-separated guild IDs allowed to use the bot (leave empty to allow all guilds it's invited to)
DISCORD_ALLOWED_GUILD_IDS=""

# --- Revolt (NOT currently functional — leave blank) ---
# revolt.py isn't installed in this image due to a hard dependency conflict with openai
# (see hermes_agent/requirements.txt for the full story). Setting REVOLT_TOKEN without
# that package installed raises a clear error at startup rather than crashing silently.
# Discord-only is fully unaffected by leaving this blank.
REVOLT_TOKEN=""
# Comma-separated channel IDs allowed to use the bot (leave empty to allow any channel it's in)
REVOLT_ALLOWED_CHANNEL_IDS=""

# --- LLM backend used by Hermes Agent ---
# Defaults to LM Studio running on the Windows host (same pattern as this workspace's
# ai-cybersecurity-devops-lab project) — reached via host.docker.internal, which
# docker-compose.yml remaps to HOST_LM_STUDIO_IP below instead of relying on Docker's
# host-gateway (which would only resolve to the VM, not the Windows host one level up).
# Point LLM_API_BASE/API_KEY at a cloud provider instead if you'd rather not run a local model.
LLM_API_BASE="http://host.docker.internal:1234/v1"
LLM_API_KEY="lm-studio"
LLM_MODEL="qwen2.5-7b-instruct"
# The Windows host's IP as seen from the VM's VirtualBox host-only adapter (default vboxnet0 IP).
# Check yours with `ip addr show | grep 192.168.56` inside the VM if it differs.
HOST_LM_STUDIO_IP="192.168.56.1"

# --- Hermes Agent runtime ---
HERMES_LOG_LEVEL="INFO"
HERMES_WORKSPACE_DIR="/workspace"

# --- Grafana ---
# Change this before first boot; do not leave the Grafana default admin/admin in place.
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="change_me_before_first_boot"
# Port Grafana is published on inside the VM. Reached via the VM's host-only IP directly
# (http://<VM_host-only-IP>:<GRAFANA_PORT>), not a VirtualBox NAT port-forward — see
# docs/INSTALL.md for why. No conflict with other VMs/projects since each VM has its own IP.
GRAFANA_PORT="3000"

# --- Loki / Promtail ---
LOKI_URL="http://loki:3100"

# --- Local web chat (bypasses Discord entirely) ---
# No token needed — enabled by default. Set to "false" for Discord-only deployments.
WEB_CHAT_ENABLED="true"
# Reached at http://<VM_host-only-IP>:<WEB_CHAT_PORT>, same firewalld-restricted-to-
# LOCAL_SUBNET posture as Grafana and the task dashboard. No login of its own.
WEB_CHAT_PORT="8503"

# --- Hermes identity + health ---
# config/soul.md defines Hermes's persona/system-prompt. If missing, a generic built-in
# default is used instead (see hermes_agent/soul.py) — the health heartbeat below reports
# which one is actually active.
SOUL_MD_PATH="/app/config/soul.md"
# How often (seconds) the background health heartbeat checks LLM reachability and logs
# soul/context status to Grafana. See docs/ARCHITECTURE.md's "Hermes health" section.
HEALTH_INTERVAL_SECONDS="300"
# Context size (tokens) of whatever model is actually loaded in LM Studio (or whatever
# LLM_API_BASE points at) — informational only, used to estimate % of context used per
# call for the health dashboard. Not read back from the backend or enforced; keep this
# in sync by hand with your loaded model.
LLM_CONTEXT_WINDOW="8192"

# --- Task dashboard ---
# Browser view/add/edit of the same task DB the summarize/task pipeline below uses.
# Reached the same way as Grafana: http://<VM_host-only-IP>:<TASK_DASHBOARD_PORT>,
# firewalld-restricted to LOCAL_SUBNET. No login of its own — do not expose further.
TASK_DASHBOARD_PORT="8502"

# --- Task automation pipeline (summarize/task commands) ---
# Paths are inside the container; docker-compose.yml bind-mounts ./data and ./notes
# to these locations, so the actual files live at the repo root on the VM.
TASK_DB_PATH="/app/data/tasks.db"
NOTES_DIR="/app/notes"
# Transcripts longer than this get truncated before being sent to the LLM, to stay clear of
# the loaded model's context window (confirmed live: an untruncated transcript triggered
# "exceeds the available context size" against an 8192-token model). Raise this if your
# loaded model has a larger context window — check LM Studio's model-load settings.
MAX_TRANSCRIPT_CHARS="20000"
