# Copy this file to `.env` on the VM and fill in real values. NEVER commit the real `.env`.
# This file is read by Docker Compose only: ports, addresses, image tags, and Grafana.
# The agent's own secrets (chat platform token, dashboard login, API key, LLM settings) go in
# hermes-data/.env, copied from hermes-data/.env.example. Do not put them here.

# --- Hermes image and network placement ---
# Pinned official image tag. Check https://hub.docker.com/r/nousresearch/hermes-agent/tags before upgrading.
HERMES_IMAGE_TAG="v2026.9.24"
# Egress proxy image. Pin a specific tag, never a rolling one, and re-check it before upgrading.
EGRESS_PROXY_IMAGE="<egress proxy image>:<pinned tag>"
# Lab network layout. Pick private subnets that don't overlap your other networks or VMs.
# AGENT_NET_DYNAMIC_RANGE must sit inside AGENT_NET_SUBNET, in its upper half; the proxy's
# fixed address must sit outside the dynamic range.
AGENT_NET_SUBNET="<agent-net subnet>/24"
AGENT_NET_DYNAMIC_RANGE="<upper half of agent-net subnet>/25"
EGRESS_NET_SUBNET="<egress-net subnet>/24"
OBS_NET_SUBNET="<observability-net subnet>/24"
# The egress proxy's fixed address inside agent-net (lower half of AGENT_NET_SUBNET).
EGRESS_PROXY_IP="<proxy address in agent-net>"
# Choose your own ports; the official image's defaults are in its documentation.
# The VM's private address. The agent API, dashboard, and Grafana bind here, never 0.0.0.0.
HERMES_BIND_IP="your_vm_host_only_ip_here"
HERMES_API_PORT="<api port>"
HERMES_DASHBOARD_PORT="<dashboard port>"
# The Windows host's address on the VM's private adapter, used to reach the local model server.
HOST_MODEL_SERVER_IP="your_host_private_ip_here"

# --- Grafana ---
# Change before first boot; do not leave default credentials in place.
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="change_me_before_first_boot"
GRAFANA_PORT="<grafana port>"
