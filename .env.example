# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` — it is excluded in .gitignore.

# --- Discord bot ---
# Create an application + bot at https://discord.com/developers/applications
DISCORD_TOKEN="your_token_here"
DISCORD_APPLICATION_ID="your_application_id_here"
# Comma-separated guild IDs allowed to use the bot (leave empty to allow all guilds it's invited to)
DISCORD_ALLOWED_GUILD_IDS=""

# --- Revolt (optional second chat platform) ---
# Leave both blank to run Discord only. See hermes_agent/adapters/revolt_adapter.py
# for a caveat on this adapter's API surface.
REVOLT_TOKEN=""
# Comma-separated channel IDs allowed to use the bot (leave empty to allow any channel it's in)
REVOLT_ALLOWED_CHANNEL_IDS=""

# --- LLM backend used by Hermes Agent ---
# Defaults to LM Studio running on the Windows host (same pattern as this workspace's
# ai-cybersecurity-devops-lab project) — reached via host.docker.internal, which
# docker-compose.yml remaps to HOST_LM_STUDIO_IP below instead of relying on Docker's
# host-gateway (which would only resolve to the VM, not the Windows host one level up).
# Point LLM_API_BASE/API_KEY at a cloud provider instead if you'd rather not run a local model.
LLM_API_BASE="http://host.docker.internal:1234/v1"
LLM_API_KEY="lm-studio"
LLM_MODEL="qwen2.5-7b-instruct"
# The Windows host's IP as seen from the VM's VirtualBox host-only adapter (default vboxnet0 IP).
# Check yours with `ip addr show | grep 192.168.56` inside the VM if it differs.
HOST_LM_STUDIO_IP="192.168.56.1"

# --- Hermes Agent runtime ---
HERMES_LOG_LEVEL="INFO"
HERMES_WORKSPACE_DIR="/workspace"

# --- Grafana ---
# Change this before first boot; do not leave the Grafana default admin/admin in place.
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="change_me_before_first_boot"
# Port Grafana is published on inside the VM. Reached via the VM's host-only IP directly
# (http://<VM_host-only-IP>:<GRAFANA_PORT>), not a VirtualBox NAT port-forward — see
# docs/INSTALL.md for why. No conflict with other VMs/projects since each VM has its own IP.
GRAFANA_PORT="3000"

# --- Loki / Promtail ---
LOKI_URL="http://loki:3100"

# --- Task automation pipeline (summarize/task commands) ---
# Paths are inside the container; docker-compose.yml bind-mounts ./data and ./notes
# to these locations, so the actual files live at the repo root on the VM.
TASK_DB_PATH="/app/data/tasks.db"
NOTES_DIR="/app/notes"
