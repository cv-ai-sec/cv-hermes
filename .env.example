# Copy this file to `.env` on the VM and fill in real values. NEVER commit the real `.env`.
# Real addresses and credentials belong only in that local .env, never in committed files.
# Two env files, two jobs:
#   - this file (`.env`, next to docker-compose.yml): compose-level values (ports, IPs, image tags)
#   - hermes-data/.env (created on the VM, git-ignored): the agent's own secrets, read inside the container.
#     Put the DISCORD_*, HERMES_DASHBOARD_BASIC_AUTH_*, API_SERVER_*, and LLM_* blocks there.

# --- Hermes image and network placement ---
# Pinned official image tag. Check https://hub.docker.com/r/nousresearch/hermes-agent/tags before upgrading.
HERMES_IMAGE_TAG="v2026.9.24"
# Egress proxy image (Squid). Tag confirmed on Docker Hub 2026-10-04; the "_edge" suffix means a
# rolling build, so re-check before upgrading. Pin a different tag if you prefer a stable build.
EGRESS_PROXY_IMAGE="ubuntu/squid:6.6-24.04_edge"
# Fixed address of the egress proxy inside agent-net (172.28.10.0/24). Must match docker-compose.yml.
EGRESS_PROXY_IP="172.28.10.2"
# The VM's host-only address. Hermes API, dashboard, and Grafana bind here, never 0.0.0.0.
HERMES_BIND_IP="your_vm_host_only_ip_here"
HERMES_API_PORT="8642"
HERMES_DASHBOARD_PORT="9119"

# --- Discord (the only internet destinations: discord.com and gateway.discord.gg) ---
DISCORD_BOT_TOKEN="your_token_here"
DISCORD_ALLOWED_USERS="your_discord_user_id_here"

# --- Dashboard login (required on non-loopback binds) ---
HERMES_DASHBOARD_BASIC_AUTH_USERNAME="your_dashboard_user_here"
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="change_me_before_first_boot"
# Generate with: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET="generate_with_openssl_rand_hex_32"

# --- API server (OpenAI-compatible) ---
API_SERVER_ENABLED="true"
API_SERVER_HOST="0.0.0.0"
# Generate with: openssl rand -hex 32
API_SERVER_KEY="generate_with_openssl_rand_hex_32"

# --- LLM: LOCAL MODELS ONLY (LM Studio on the Windows host). ---
# No cloud LLM providers for now. The egress proxy already blocks them; do not add one without
# a new audit entry and a change to docs/SECURITY.md.
# The agent's base URL and model are set by the setup wizard in hermes-data/config.yaml, pointing
# at http://host.docker.internal:1234/v1. The LM Studio key is a placeholder; LM Studio ignores it.
# Put this in hermes-data/.env, read by the agent as OPENAI_API_KEY:
#   OPENAI_API_KEY="lm-studio"
# The Windows host's address on the VM's host-only adapter (compose-level, used for host.docker.internal).
HOST_LM_STUDIO_IP="your_windows_host_only_ip_here"

# --- Grafana ---
# Change before first boot; do not leave admin/admin in place.
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="change_me_before_first_boot"
GRAFANA_PORT="3000"
