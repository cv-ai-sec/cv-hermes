# --- Secrets & environment ---
.env
.env.local
.env.*.local
*.pem
*.key
keys/

# --- Runtime data & logs ---
*.log
logs/
workspace/*
!workspace/.gitkeep
data/*
!data/.gitkeep
notes/*
!notes/.gitkeep

# --- Hermes runtime state: .env, sessions, memories, skills (holds the Discord token) ---
hermes-data/*
!hermes-data/.env.example

# --- Loki / Grafana runtime state (bind-mounted volumes) ---
loki-data/
grafana-data/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
