{
  "title": "Hermes Agent Overview",
  "uid": "hermes-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Errors per minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"hermes-agent\", event=\"error\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Task latency (ms, p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, {job=\"hermes-agent\", event=\"task_latency\"} | json | unwrap latency_ms [5m])",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "quantile_over_time(0.95, {job=\"hermes-agent\", event=\"task_latency\"} | json | unwrap latency_ms [5m])",
          "refId": "B",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Token usage (prompt + completion)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum(sum_over_time({job=\"hermes-agent\", event=\"token_usage\"} | json | unwrap tokens_prompt [5m]))",
          "refId": "A",
          "legendFormat": "prompt"
        },
        {
          "expr": "sum(sum_over_time({job=\"hermes-agent\", event=\"token_usage\"} | json | unwrap tokens_completion [5m]))",
          "refId": "B",
          "legendFormat": "completion"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tool calls by tool name",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum by (tool_name) (count_over_time({job=\"hermes-agent\", event=\"tool_call\"} | json [5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Notes generated (word count)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum(sum_over_time({job=\"hermes-agent\", event=\"note_generated\"} | json | unwrap word_count [5m]))",
          "refId": "A",
          "legendFormat": "words"
        }
      ]
    },
    {
      "id": 6,
      "title": "Task status changes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum by (task_status) (count_over_time({job=\"hermes-agent\", event=\"task_status_change\"} | json [5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Live log stream",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        { "expr": "{job=\"hermes-agent\"}", "refId": "A" }
      ]
    }
  ]
}
