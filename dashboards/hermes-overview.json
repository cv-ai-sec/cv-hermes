{
  "title": "Hermes Agent Overview",
  "uid": "hermes-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Errors per minute",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"hermes-agent\", event=\"error\"}[1m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Task latency (ms, p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, {job=\"hermes-agent\", event=\"task_latency\"} | json | unwrap latency_ms [5m])",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "quantile_over_time(0.95, {job=\"hermes-agent\", event=\"task_latency\"} | json | unwrap latency_ms [5m])",
          "refId": "B",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 3,
      "title": "Token usage (prompt + completion)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum(sum_over_time({job=\"hermes-agent\", event=\"token_usage\"} | json | unwrap tokens_prompt [5m]))",
          "refId": "A",
          "legendFormat": "prompt"
        },
        {
          "expr": "sum(sum_over_time({job=\"hermes-agent\", event=\"token_usage\"} | json | unwrap tokens_completion [5m]))",
          "refId": "B",
          "legendFormat": "completion"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tool calls by tool name",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum by (tool_name) (count_over_time({job=\"hermes-agent\", event=\"tool_call\"} | json [5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Notes generated (word count)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum(sum_over_time({job=\"hermes-agent\", event=\"note_generated\"} | json | unwrap word_count [5m]))",
          "refId": "A",
          "legendFormat": "words"
        }
      ]
    },
    {
      "id": 6,
      "title": "Task status changes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum by (task_status) (count_over_time({job=\"hermes-agent\", event=\"task_status_change\"} | json [5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Live log stream",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        { "expr": "{job=\"hermes-agent\"}", "refId": "A" }
      ]
    },
    {
      "id": 8,
      "title": "Hermes health",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "title": "LLM backend reachable",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 35 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "last_over_time({job=\"hermes-agent\", event=\"health_heartbeat\"} | json | unwrap llm_reachable [15m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "soul.md loaded",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 35 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DEFAULT (soul.md missing)", "color": "yellow" }, "1": { "text": "LOADED", "color": "green" } } }
          ]
        }
      },
      "targets": [
        {
          "expr": "last_over_time({job=\"hermes-agent\", event=\"health_heartbeat\"} | json | unwrap soul_loaded [15m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Uptime",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 35 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "targets": [
        {
          "expr": "last_over_time({job=\"hermes-agent\", event=\"health_heartbeat\"} | json | unwrap uptime_seconds [15m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Active adapters",
      "type": "logs",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 35 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "options": { "showTime": false },
      "targets": [
        {
          "expr": "{job=\"hermes-agent\", event=\"health_heartbeat\"} | json | line_format \"{{.adapters_active}}\"",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Context window usage (% of configured context, p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100, "min": 0 } },
      "targets": [
        {
          "expr": "quantile_over_time(0.50, {job=\"hermes-agent\", event=\"context_usage\"} | json | unwrap context_pct [5m])",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "quantile_over_time(0.95, {job=\"hermes-agent\", event=\"context_usage\"} | json | unwrap context_pct [5m])",
          "refId": "B",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 14,
      "title": "Context window overflow errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "datasource": { "type": "loki", "uid": "Loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({job=\"hermes-agent\", event=\"error\"} | json | error_type=\"llm_context_overflow\" [5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
